function pickUpgrade(name) {
  if (name === "fast_evolution") state.multiplier = FAST_EVOLUTION_MULTIPLIER;
  if (name === "precise_selection") state.preciseAvailable = true;
  if (name === "cell_division") state.maxSelection = EXTENDED_MAX_SELECTION;

  els.upgrades.hidden = true;
  state.running = true;
  renderHud();
  renderCurrent();

  if (state.turn > ROUNDS) endGame();
}

function endGame() {
  state.running = false;
  els.gameover.hidden = false;
  els.finalScore.textContent = state.score;
  els.confirm.disabled = true;
  els.removeOne.disabled = true;
}

function restart() {
  _id = 0;
  const fresh = cloneState(INITIAL_STATE);
  Object.assign(state, fresh);

  ORGANELLES.forEach(o => state.pool.push({ key: o.key, id: nextId() }));

  els.gameover.hidden = true;
  els.upgrades.hidden = true;
  els.message.textContent = "";

  renderHud();
  renderPool();
  renderCurrent();
}

els.confirm.addEventListener("click", confirmCombo);
els.resetSelection.addEventListener("click", () => {
  if (!state.running) return;
  state.selected.clear();
  renderPool();
  renderCurrent();
});
els.removeOne.addEventListener("click", removeOne);
els.restart.addEventListener("click", restart);
els.upgrades.addEventListener("click", e => {
  const btn = e.target.closest(".upgrade");
  if (!btn) return;
  pickUpgrade(btn.dataset.upgrade);
});

restart();
