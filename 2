// Клеточная лаборатория — игра по TASK.md @eefiryy

const ORGANELLES = [
  { key: "nucleus",      name: "Ядро",        icon: "🧬" }, // 1F9EC, Unicode 11
  { key: "membrane",     name: "Мембрана",    icon: "💠" }, // 1F4A0, Unicode 6.0
  { key: "mitochondria", name: "Митохондрия", icon: "⚡" }, // 26A1, Unicode 4.0
  { key: "ribosome",     name: "Рибосома",    icon: "🔬" }, // 1F52C, Unicode 6.0
  { key: "chloroplast",  name: "Хлоропласт",  icon: "🌿" }, // 1F33F, Unicode 6.0
  { key: "vacuole",      name: "Вакуоль",     icon: "💧" }, // 1F4A7, Unicode 6.0
];
const NAMES = Object.fromEntries(ORGANELLES.map(o => [o.key, o.name]));


let state = cloneState(INITIAL_STATE);
let _id = 0;
const nextId = () => ++_id;

function renderHud() {
  els.score.textContent = state.score;
  els.turn.textContent = state.turn;
  els.multiplier.textContent = "×" + state.multiplier.toString().replace(".", ",");
}

function renderPool() {
  els.organelles.innerHTML = "";
  state.pool.forEach(item => {
    const info = ORGANELLES.find(o => o.key === item.key);
    const btn = document.createElement("button");
    btn.className = "organelle" + (state.selected.has(item.id) ? " selected" : "");
    btn.dataset.id = item.id;
    btn.innerHTML = `<span class="icon">${info.icon}</span>${info.name}`;
    btn.addEventListener("click", () => toggleSelect(item.id));
    els.organelles.appendChild(btn);
  });

  const combo = findCombo(keys);
  if (keys.length === 0) {
    els.comboInfo.textContent = "Комбинация: —";
    els.comboInfo.classList.remove("valid");
  } else if (combo) {
    const total = Math.round(combo.points * state.multiplier);
    els.comboInfo.textContent = `Комбинация: ${combo.title} — ${total} очков`;
    els.comboInfo.classList.add("valid");
  } else {
    els.comboInfo.textContent = "Комбинация: неизвестная (нельзя подтвердить)";
    els.comboInfo.classList.remove("valid");
  }

  els.confirm.disabled = !combo || !state.running;
  els.removeOne.disabled = !(state.running && state.preciseAvailable && state.selected.size > 0);
}

function toggleSelect(id) {
  if (!state.running) return;
  if (state.selected.has(id)) {
    state.selected.delete(id);
  } else {
    if (state.selected.size >= state.maxSelection) {
      flash(`Максимум ${state.maxSelection} элементов в наборе`);
      return;
    }
    state.selected.add(id);
  }
  renderPool();
  renderCurrent();
}

function flash(text) {
  els.message.textContent = text;
  clearTimeout(flash._t);
  flash._t = setTimeout(() => { els.message.textContent = ""; }, 1300);
}

function refillPool() {
  while (state.pool.length < POOL_SIZE) {
    state.pool.push({ key: randomOrganelleKey(), id: nextId() });
  }
}

function randomOrganelleKey() {
  return ORGANELLES[Math.floor(Math.random() * ORGANELLES.length)].key;
}

function confirmCombo() {
  const keys = selectedKeys();
  const combo = findCombo(keys);
  if (!combo || !state.running) return;

  const gained = Math.round(combo.points * state.multiplier);
  state.score += gained;
  flash(`+${gained} (${combo.title})`);

  const usedIds = new Set(state.selected);
  state.pool = state.pool.filter(p => !usedIds.has(p.id));
  state.selected.clear();
  refillPool();

  state.turn += 1;
  renderHud();
  renderPool();
  renderCurrent();

  if (!state.upgradeOffered && state.score >= UPGRADE_THRESHOLD) {
    offerUpgrade();
    return;
  }
  if (state.turn > ROUNDS) endGame();
}

function offerUpgrade() {
  state.upgradeOffered = true;
  state.running = false;
  els.upgrades.hidden = false;
  els.confirm.disabled = true;
  els.removeOne.disabled = true;
}

function pickUpgrade(name) {
  if (name === "fast_evolution") state.multiplier = FAST_EVOLUTION_MULTIPLIER;
  if (name === "precise_selection") state.preciseAvailable = true;
  if (name === "cell_division") state.maxSelection = EXTENDED_MAX_SELECTION;

  els.upgrades.hidden = true;
  state.running = true;
  renderHud();
  renderCurrent();

  if (state.turn > ROUNDS) endGame();
}

function removeOne() {
  if (!state.preciseAvailable || state.selected.size === 0) return;
  const firstId = [...state.selected][0];
  state.selected.delete(firstId);
  state.preciseAvailable = false;
  renderPool();
  renderCurrent();
  flash("Точный отбор использован: один элемент сброшен");
}

function endGame() {
  state.running = false;
  els.gameover.hidden = false;
  els.finalScore.textContent = state.score;
  els.confirm.disabled = true;
  els.removeOne.disabled = true;
}

function restart() {
  _id = 0;
  const fresh = cloneState(INITIAL_STATE);
  Object.assign(state, fresh);

  ORGANELLES.forEach(o => state.pool.push({ key: o.key, id: nextId() }));

  els.gameover.hidden = true;
  els.upgrades.hidden = true;
  els.message.textContent = "";

  renderHud();
  renderPool();
  renderCurrent();
}

els.confirm.addEventListener("click", confirmCombo);
els.resetSelection.addEventListener("click", () => {
  if (!state.running) return;
  state.selected.clear();
  renderPool();
  renderCurrent();
});
els.removeOne.addEventListener("click", removeOne);
els.restart.addEventListener("click", restart);
els.upgrades.addEventListener("click", e => {
  const btn = e.target.closest(".upgrade");
  if (!btn) return;
  pickUpgrade(btn.dataset.upgrade);
});

restart();
